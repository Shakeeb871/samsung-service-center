# ---------------------------------------------------------------------
# Samsung Service Center
#
# Nothing here assumes the site is at the top of the web root. Every rule
# is relative, so this file works whether the site sits at the domain root
# or inside a folder of any name.
# ---------------------------------------------------------------------

# Every page is a folder with an index.php inside it, so /contact/ and
# /services/samsung-ac-repair/ resolve on their own. No rewrite rules are
# needed to produce clean URLs, which is why there are none.
DirectoryIndex index.php

# Directory listings would expose the file layout. MultiViews guesses at
# filenames and interferes with the folder structure above.
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- One address ---------------------------------------------------
  # www and non-www are two different addresses as far as a search engine
  # is concerned, and a site reachable at both splits its own ranking
  # between them. Everything is sent to the version without www.
  #
  # This rule sends straight to https as well, so www over http arrives in
  # a single redirect rather than being bounced twice. Each extra hop is
  # another round trip before the page starts loading.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # --- HTTPS ---------------------------------------------------------
  # The forwarded header is checked too: behind a proxy that terminates
  # TLS, %{HTTPS} reads "off" and this becomes a redirect loop without it.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # --- Sitemap -------------------------------------------------------
  # Generated by sitemap.php but served where everything expects it.
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # --- Robots --------------------------------------------------------
  # Same reason: the Sitemap line inside it has to carry the live domain.
  RewriteRule ^robots\.txt$ robots.php [L]

  # --- The include folder is not web content -------------------------
  # config.php holds the business details; header and footer are partials.
  RewriteRule ^inc/ - [F,L]

  # The repository is cloned straight into the web root on PHP hosting,
  # so the files that only matter to development end up public with it.
  # build.php in particular would start a PHP server if anyone fetched it.
  RewriteRule ^(build\.php|DEPLOY\.md|README\.md|\.gitignore)$ - [F,L]
  RewriteRule ^(\.github|dist)/ - [F,L]

  # --- Branded 404 ---------------------------------------------------
  # A relative target, so it resolves inside whatever folder this file is
  # in. 404.php sets the 404 status itself.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ 404.php [L]
</IfModule>

# --- Compression -----------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Caching ---------------------------------------------------------
# Images and fonts keep a long lifetime; their URLs rarely change.
#
# CSS and JS are held for a month, not a year. Their URLs already carry a
# ?v= stamp from inc/config.php that changes whenever the file changes, so
# a new build is a new URL and is fetched at once. The shorter lifetime is
# the safety net for anything that reaches a browser without that stamp.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 month"
  ExpiresByType application/javascript  "access plus 1 month"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

# --- MIME types ------------------------------------------------------
# Apache does not know the manifest extension out of the box and would
# serve it as a download, which browsers ignore.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/x-icon              .ico
</IfModule>

# --- Security headers ------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always unset X-Powered-By
</IfModule>

# --- Dotfiles and the repository -------------------------------------
# The git clone lives in this folder, which means .git sits inside the web
# root. It holds the project's entire history and must not be readable.
# FilesMatch only covers files, so the directory is blocked by rewrite.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^\.git(/|$) - [F,L]
</IfModule>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# .cpanel.yml and this file itself are configuration, not web content.
<FilesMatch "^(\.cpanel\.yml|\.gitignore|README\.md)$">
  Require all denied
</FilesMatch>
